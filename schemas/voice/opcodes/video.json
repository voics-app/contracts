{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/voice/opcodes/video.json",
  "title": "VideoPayload",
  "description": "Voice op 12 VIDEO.",
  "type": "object",
  "required": [
    "audio_ssrc",
    "video_ssrc",
    "rtx_ssrc",
    "streams"
  ],
  "properties": {
    "audio_ssrc": {
      "type": "integer",
      "minimum": 0
    },
    "video_ssrc": {
      "type": "integer",
      "minimum": 0
    },
    "rtx_ssrc": {
      "type": "integer",
      "minimum": 0
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "../stream.json"
      }
    },
    "user_id": {
      "$ref": "../../objects/snowflake.json",
      "description": "Set by the server when relaying another user's announcement."
    },
    "soundboard_ssrc": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4294967295,
      "description": "Separate soundboard audio SSRC, when negotiated."
    }
  }
}
