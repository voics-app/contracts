{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/voice/opcodes/publish-permissions.json",
  "title": "PublishPermissionsPayload",
  "description": "Proposed voice op 41, sent only to the affected session after the SFU has applied the capability. This is informational; the SFU enforces publication. Absence, expiry, stale revision or disconnection means deny.",
  "type": "object",
  "required": [
    "session_id",
    "revision",
    "expires_at",
    "can_publish_audio",
    "can_publish_video",
    "can_publish_soundboard"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix milliseconds; a bounded deadline enforced by the SFU."
    },
    "can_publish_audio": {
      "type": "boolean"
    },
    "can_publish_video": {
      "type": "boolean"
    },
    "can_publish_soundboard": {
      "type": "boolean"
    }
  }
}
