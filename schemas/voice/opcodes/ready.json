{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/voice/opcodes/ready.json",
  "title": "VoiceReadyPayload",
  "description": "Voice op 2 READY.",
  "type": "object",
  "required": [
    "ssrc",
    "ip",
    "port",
    "modes",
    "streams"
  ],
  "properties": {
    "ssrc": {
      "type": "integer",
      "minimum": 0
    },
    "ip": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 0
    },
    "modes": {
      "type": "array",
      "items": {
        "const": "dtls-srtp"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "../stream.json"
      }
    },
    "soundboard_transport": {
      "type": "boolean",
      "description": "True only when the node supports the fully enforced soundboard transport. Missing or false disables the extra sender track."
    }
  }
}
