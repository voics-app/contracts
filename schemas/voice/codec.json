{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/voice/codec.json",
  "title": "VoiceCodec",
  "description": "A codec offered by the client. Shipped desktop and mobile clients prefer VP8 for interoperable camera and screen video. The SFU forwards encoded payloads unchanged; peers must negotiate a common video codec. Older desktop builds preferring VP9 require an update for mobile video.",
  "type": "object",
  "required": [
    "name",
    "type",
    "priority",
    "payload_type"
  ],
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "opus",
        "VP8",
        "VP9",
        "AV1",
        "H264"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "payload_type": {
      "type": "integer",
      "minimum": 0
    },
    "rtx_payload_type": {
      "type": "integer",
      "minimum": 0
    }
  }
}
