{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/template-channel.json",
  "title": "TemplateChannel",
  "description": "A channel of a template. `id` and `parent_id` are template-local ids, numbered from 1.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "position",
    "topic",
    "nsfw",
    "parent_id",
    "permission_overwrites"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "integer",
      "description": "ChannelType: 0 text, 2 voice, 4 category, 5 announcement, 13 stage, 15 forum."
    },
    "name": {
      "type": "string"
    },
    "position": {
      "type": "integer"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "nsfw": {
      "type": "boolean"
    },
    "bitrate": {
      "type": "integer"
    },
    "user_limit": {
      "type": "integer"
    },
    "rate_limit_per_user": {
      "type": "integer"
    },
    "parent_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "permission_overwrites": {
      "type": "array",
      "items": {
        "$ref": "./template-overwrite.json"
      }
    }
  }
}
