{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/member-verification.json",
  "title": "MemberVerification",
  "type": "object",
  "required": ["enabled", "rules", "revision", "pending"],
  "properties": {
    "enabled": { "type": "boolean" },
    "rules": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "revision": { "type": "integer", "minimum": 0 },
    "pending": { "type": "boolean", "description": "Whether the caller must accept the rules." }
  }
}
