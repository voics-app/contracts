{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/user-settings.json",
  "title": "UserSettings",
  "description": "Account-wide settings of the current user. `default_delivery_mode` is a Discordy extra.",
  "type": "object",
  "required": [
    "locale",
    "theme",
    "status",
    "custom_status",
    "default_delivery_mode",
    "e2ee_calls_default",
    "developer_mode",
    "message_display_compact",
    "guild_folders",
    "guild_positions",
    "pinned_dm_channel_ids",
    "pinned_channel_ids",
    "preferences"
  ],
  "properties": {
    "locale": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "oled"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "idle",
        "dnd",
        "invisible"
      ]
    },
    "custom_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CustomStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "default_delivery_mode": {
      "$ref": "./delivery-mode.json",
      "description": "Default delivery mode for DMs and group DMs without a per-chat override."
    },
    "e2ee_calls_default": {
      "type": "boolean",
      "description": "When true, every call the user starts or joins is end-to-end encrypted (DMs, group DMs, voice channels, Go Live). A call is E2EE for everyone when any participant has this set."
    },
    "developer_mode": {
      "type": "boolean"
    },
    "message_display_compact": {
      "type": "boolean"
    },
    "accent_color": {
      "type": [
        "integer",
        "null"
      ]
    },
    "guild_folders": {
      "type": "array",
      "description": "The user's server rail in order, with folders. Synced across devices.",
      "items": {
        "$ref": "./guild-folder.json"
      },
      "maxItems": 200
    },
    "pinned_dm_channel_ids": {
      "type": "array",
      "description": "DM and group DM channels pinned to the top of the DM list (at most 5), most recently pinned last. Synced across devices.",
      "items": {
        "$ref": "./snowflake.json"
      }
    },
    "pinned_channel_ids": {
      "type": "object",
      "description": "Personal pinned channels per server, at most 10 per server (guild id to channel ids, most recently pinned last), shown at the top of that server's channel list. Visible only to the user. Synced across devices.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "./snowflake.json"
        }
      },
      "maxProperties": 200
    },
    "guild_positions": {
      "type": "array",
      "description": "Flat server order (legacy mirror of guild_folders).",
      "items": {
        "$ref": "./snowflake.json"
      },
      "maxItems": 200
    },
    "preferences": {
      "$ref": "./user-preferences.json",
      "description": "Synced client preferences (appearance, chat, notification sounds, emoji). Sparse."
    },
    "friend_source_flags": {
      "$ref": "./friend-source-flags.json"
    }
  },
  "$defs": {
    "CustomStatus": {
      "title": "CustomStatus",
      "description": "A user's custom status.",
      "type": "object",
      "required": [
        "text",
        "emoji_id",
        "emoji_name",
        "expires_at"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "emoji_id": {
          "anyOf": [
            {
              "$ref": "./snowflake.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "emoji_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
