{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/message.json",
  "title": "Message",
  "description": "A standard-mode message.",
  "type": "object",
  "required": [
    "id",
    "channel_id",
    "author",
    "content",
    "timestamp",
    "edited_timestamp",
    "tts",
    "mention_everyone",
    "mentions",
    "mention_roles",
    "attachments",
    "embeds",
    "pinned",
    "type"
  ],
  "properties": {
    "id": {
      "$ref": "./snowflake.json"
    },
    "channel_id": {
      "$ref": "./snowflake.json"
    },
    "author": {
      "$ref": "./user.json"
    },
    "content": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "edited_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tts": {
      "type": "boolean"
    },
    "mention_everyone": {
      "type": "boolean"
    },
    "mention_here": {
      "type": "boolean",
      "description": "Extension. With mention_everyone: the message pings with @here only (no @everyone), so only members who are online at send time are notified. Absent or false otherwise."
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "./user.json"
      }
    },
    "mention_roles": {
      "type": "array",
      "items": {
        "$ref": "./snowflake.json"
      }
    },
    "mention_channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChannelMention"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "./attachment.json"
      }
    },
    "embeds": {
      "type": "array",
      "items": {
        "$ref": "./embed.json"
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "$ref": "./reaction.json"
      }
    },
    "nonce": {
      "type": "string",
      "maxLength": 25,
      "description": "Client nonce used to resolve optimistic sends."
    },
    "pinned": {
      "type": "boolean"
    },
    "hit": {
      "type": "boolean",
      "description": "Only in message search results: true for the matching message, absent for its context messages."
    },
    "webhook_id": {
      "$ref": "./snowflake.json"
    },
    "type": {
      "type": "integer",
      "description": "MessageType. 0 DEFAULT, 1 RECIPIENT_ADD, 2 RECIPIENT_REMOVE, 3 CALL (see call), 4 CHANNEL_NAME_CHANGE, 5 CHANNEL_ICON_CHANGE, 6 CHANNEL_PINNED_MESSAGE (message_reference is the pinned message), 7 GUILD_MEMBER_JOIN (author is the member who joined; posted in the guild system channel when one is set), 18 THREAD_CREATED (content is the thread name, message_reference.channel_id the thread), 19 REPLY. A forwarded message keeps type 0 and is identified by message_reference.type = 1 plus message_snapshots (Discord semantics)."
    },
    "application_id": {
      "$ref": "./snowflake.json"
    },
    "flags": {
      "type": "integer"
    },
    "message_reference": {
      "$ref": "./message-reference.json"
    },
    "call": {
      "$ref": "#/$defs/MessageCall"
    },
    "referenced_message": {
      "anyOf": [
        {
          "$ref": "./message.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "interaction_metadata": {
      "$ref": "#/$defs/MessageInteractionMetadata"
    },
    "thread": {
      "$ref": "./channel.json"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "./message-component.json"
      }
    },
    "position": {
      "type": "integer"
    },
    "message_snapshots": {
      "type": "array",
      "description": "Present on messages with message_reference.type = 1 (FORWARD): a frozen copy of the forwarded message taken at forward time.",
      "items": {
        "$ref": "./message-snapshot.json"
      }
    },
    "poll": {
      "$ref": "./poll.json"
    }
  },
  "$defs": {
    "MessageCall": {
      "title": "MessageCall",
      "description": "Payload of a type 3 (CALL) message. ended_timestamp is null while the call is running and is set when it ends.",
      "type": "object",
      "required": [
        "participants"
      ],
      "properties": {
        "participants": {
          "type": "array",
          "description": "IDs of the users who took part in the call.",
          "items": {
            "$ref": "./snowflake.json"
          }
        },
        "ended_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "ChannelMention": {
      "title": "ChannelMention",
      "description": "A channel mentioned in a message.",
      "type": "object",
      "required": [
        "id",
        "guild_id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "./snowflake.json"
        },
        "guild_id": {
          "$ref": "./snowflake.json"
        },
        "type": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "MessageInteractionMetadata": {
      "title": "MessageInteractionMetadata",
      "description": "The interaction a message responds to.",
      "type": "object",
      "required": [
        "id",
        "type",
        "user"
      ],
      "properties": {
        "id": {
          "$ref": "./snowflake.json"
        },
        "type": {
          "type": "integer"
        },
        "user": {
          "$ref": "./user.json"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
