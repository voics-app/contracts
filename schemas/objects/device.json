{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/device.json",
  "title": "Device",
  "description": "A user device with its Ed25519 identity key (Discordy extra).",
  "type": "object",
  "required": [
    "device_id",
    "identity_key_b64"
  ],
  "properties": {
    "device_id": {
      "$ref": "./snowflake.json"
    },
    "identity_key_b64": {
      "type": "string",
      "description": "Ed25519 public identity key, base64."
    },
    "name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
