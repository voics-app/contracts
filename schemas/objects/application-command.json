{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/application-command.json",
  "title": "ApplicationCommand",
  "description": "A slash, user or message command.",
  "type": "object",
  "required": [
    "id",
    "application_id",
    "name",
    "description",
    "default_member_permissions",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "./snowflake.json"
    },
    "type": {
      "type": "integer",
      "description": "ApplicationCommandType (default 1)."
    },
    "application_id": {
      "$ref": "./snowflake.json"
    },
    "guild_id": {
      "$ref": "./snowflake.json"
    },
    "name": {
      "type": "string"
    },
    "name_localizations": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "description_localizations": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "./application-command-option.json"
      }
    },
    "default_member_permissions": {
      "anyOf": [
        {
          "$ref": "./permission-bitset.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "dm_permission": {
      "type": "boolean"
    },
    "nsfw": {
      "type": "boolean"
    },
    "contexts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      }
    },
    "integration_types": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "version": {
      "$ref": "./snowflake.json"
    }
  }
}
