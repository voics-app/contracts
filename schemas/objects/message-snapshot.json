{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/message-snapshot.json",
  "title": "MessageSnapshot",
  "description": "A frozen copy of a forwarded message. Attachments are re-referenced (same stored object, freshly signed URLs); the snapshot never changes when the source is edited or deleted.",
  "type": "object",
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "object",
      "required": [
        "content",
        "timestamp",
        "edited_timestamp",
        "mentions",
        "mention_roles",
        "attachments",
        "embeds",
        "type"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "edited_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "mentions": {
          "type": "array",
          "items": {
            "$ref": "./user.json"
          }
        },
        "mention_roles": {
          "type": "array",
          "items": {
            "$ref": "./snowflake.json"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "./attachment.json"
          }
        },
        "embeds": {
          "type": "array",
          "items": {
            "$ref": "./embed.json"
          }
        },
        "type": {
          "type": "integer"
        },
        "flags": {
          "type": "integer"
        }
      }
    }
  }
}
