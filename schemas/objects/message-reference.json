{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/message-reference.json",
  "title": "MessageReference",
  "description": "Reference to another message (reply, forward, crosspost).",
  "type": "object",
  "properties": {
    "type": {
      "type": "integer"
    },
    "message_id": {
      "$ref": "./snowflake.json"
    },
    "channel_id": {
      "$ref": "./snowflake.json"
    },
    "guild_id": {
      "$ref": "./snowflake.json"
    },
    "fail_if_not_exists": {
      "type": "boolean"
    }
  }
}
