{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/user.json",
  "title": "User",
  "description": "A Discordy user (Discord v10 User object).",
  "type": "object",
  "required": [
    "id",
    "username",
    "discriminator",
    "global_name",
    "avatar"
  ],
  "properties": {
    "id": {
      "$ref": "./snowflake.json"
    },
    "username": {
      "type": "string"
    },
    "discriminator": {
      "type": "string",
      "description": "Always \"0\" (unique usernames)."
    },
    "global_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "avatar": {
      "type": [
        "string",
        "null"
      ],
      "description": "Avatar hash."
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "Profile About me text, at most 300 characters."
    },
    "bot": {
      "type": "boolean"
    },
    "system": {
      "type": "boolean"
    },
    "mfa_enabled": {
      "type": "boolean"
    },
    "banner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Profile banner hash."
    },
    "accent_color": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 16777215
    },
    "locale": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "description": "Only returned for the current user."
    },
    "flags": {
      "type": "integer"
    },
    "public_flags": {
      "type": "integer"
    },
    "pronouns": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40,
      "description": "Optional public pronouns; trimmed, null or blank clears them. At most 40 Unicode characters."
    },
    "theme_colors": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16777215
      },
      "description": "Exactly two RGB colors (0..16777215) for the profile theme. Null resets to the default theme."
    }
  }
}
