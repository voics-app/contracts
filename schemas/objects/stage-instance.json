{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/stage-instance.json",
  "title": "StageInstance",
  "description": "A live guild-only stage instance.",
  "type": "object",
  "required": ["id", "guild_id", "channel_id", "topic", "privacy_level", "discoverable_disabled"],
  "properties": {
    "id": { "$ref": "./snowflake.json" },
    "guild_id": { "$ref": "./snowflake.json" },
    "channel_id": { "$ref": "./snowflake.json" },
    "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
    "privacy_level": { "type": "integer", "const": 2 },
    "discoverable_disabled": { "type": "boolean" }
  }
}
