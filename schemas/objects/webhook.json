{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/objects/webhook.json",
  "title": "Webhook",
  "description": "An incoming, channel-follower or application webhook.",
  "type": "object",
  "required": [
    "id",
    "type",
    "channel_id",
    "name",
    "avatar",
    "application_id"
  ],
  "properties": {
    "id": {
      "$ref": "./snowflake.json"
    },
    "type": {
      "type": "integer",
      "description": "WebhookType."
    },
    "guild_id": {
      "anyOf": [
        {
          "$ref": "./snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel_id": {
      "anyOf": [
        {
          "$ref": "./snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "user": {
      "$ref": "./user.json"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "avatar": {
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "type": "string",
      "description": "Execution credential returned only by create and reset-token; never stored in list/get/edit responses."
    },
    "application_id": {
      "anyOf": [
        {
          "$ref": "./snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "type": "string",
      "description": "Execution URL returned only by create and reset-token. Treat as a secret."
    }
  }
}
