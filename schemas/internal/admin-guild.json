{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/internal/admin-guild.json",
  "title": "AdminGuild",
  "description": "A guild as listed in the admin portal.",
  "type": "object",
  "required": [
    "id",
    "name",
    "owner_id",
    "member_count",
    "voice_region",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../objects/snowflake.json"
    },
    "name": {
      "type": "string"
    },
    "owner_id": {
      "$ref": "../objects/snowflake.json"
    },
    "member_count": {
      "type": "integer",
      "minimum": 0
    },
    "voice_region": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
