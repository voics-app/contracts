{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/internal/gateway-admin-stats.json",
  "title": "GatewayAdminStats",
  "description": "GET /internal/v1/admin/stats on gateway.",
  "type": "object",
  "required": [
    "sessions_online",
    "sessions_by_node",
    "guild_processes",
    "voice_allocations"
  ],
  "properties": {
    "sessions_online": {
      "type": "integer",
      "minimum": 0
    },
    "sessions_by_node": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "guild_processes": {
      "type": "integer",
      "minimum": 0
    },
    "voice_allocations": {
      "type": "integer",
      "minimum": 0
    }
  }
}
