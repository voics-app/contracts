{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/internal/user-ready.json",
  "title": "UserReadyState",
  "description": "GET /internal/v1/users/{user_id}/ready: the state used to build READY.",
  "type": "object",
  "required": [
    "user",
    "guilds",
    "private_channels",
    "relationships",
    "user_settings",
    "user_guild_settings",
    "notes"
  ],
  "properties": {
    "user": {
      "$ref": "../objects/user.json"
    },
    "guilds": {
      "type": "array",
      "items": {
        "$ref": "../objects/guild-full.json"
      }
    },
    "private_channels": {
      "type": "array",
      "items": {
        "$ref": "../objects/channel.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../objects/relationship.json"
      }
    },
    "user_settings": {
      "$ref": "../objects/user-settings.json"
    },
    "user_guild_settings": {
      "type": "array",
      "items": {
        "$ref": "../objects/guild-notification-settings.json"
      },
      "description": "Stored notification settings of the user's guilds and DMs (guild_id null); guilds without a row use the defaults."
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "description": "The user's private notes keyed by the noted user's id."
    }
  }
}
