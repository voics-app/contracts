{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/login-request.json",
  "title": "LoginRequest",
  "description": "POST /auth/login body.",
  "type": "object",
  "required": [
    "email",
    "password"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string"
    },
    "totp": {
      "type": "string",
      "pattern": "^[0-9]{6}$",
      "description": "Required when 2FA is enabled."
    }
  }
}
