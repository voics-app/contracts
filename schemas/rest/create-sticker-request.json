{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-sticker-request.json",
  "title": "CreateStickerRequest",
  "description": "Create a guild sticker from a data URI.",
  "type": "object",
  "required": [
    "name",
    "tags",
    "image"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30
    },
    "tags": {
      "type": "string",
      "maxLength": 200
    },
    "image": {
      "type": "string",
      "description": "Data URI containing a PNG, APNG, GIF or Lottie JSON sticker."
    }
  }
}
