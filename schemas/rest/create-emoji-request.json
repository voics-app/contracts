{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-emoji-request.json",
  "title": "CreateEmojiRequest",
  "description": "POST /guilds/{id}/emojis body.",
  "type": "object",
  "required": [
    "name",
    "image"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "description": "Data URI, 256 KiB max."
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "../objects/snowflake.json"
      }
    }
  }
}
