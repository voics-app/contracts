{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/passkey.json",
  "title": "Passkey",
  "description": "Registered second factor metadata. Credential public keys and challenges are never included.",
  "type": "object",
  "required": [
    "id",
    "name",
    "created_at",
    "last_used_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
