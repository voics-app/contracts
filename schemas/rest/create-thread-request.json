{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-thread-request.json",
  "title": "CreateThreadRequest",
  "description": "POST /channels/{id}/threads body. Forum channels require `message`.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "auto_archive_duration": {
      "type": "integer",
      "enum": [
        60,
        1440,
        4320,
        10080
      ]
    },
    "type": {
      "type": "integer"
    },
    "invitable": {
      "type": "boolean"
    },
    "rate_limit_per_user": {
      "type": [
        "integer",
        "null"
      ]
    },
    "applied_tags": {
      "type": "array",
      "items": {
        "$ref": "../objects/snowflake.json"
      }
    },
    "message": {
      "$ref": "./create-message-request.json"
    }
  }
}
