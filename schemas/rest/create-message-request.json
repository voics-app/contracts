{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-message-request.json",
  "title": "CreateMessageRequest",
  "description": "POST /channels/{id}/messages body. Returns 409 (code 50160) when the effective delivery mode is not standard.",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "maxLength": 2000
    },
    "nonce": {
      "type": "string",
      "maxLength": 25
    },
    "tts": {
      "type": "boolean"
    },
    "embeds": {
      "type": "array",
      "items": {
        "$ref": "../objects/embed.json"
      },
      "maxItems": 10
    },
    "allowed_mentions": {
      "$ref": "../objects/allowed-mentions.json"
    },
    "message_reference": {
      "$ref": "../objects/message-reference.json"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "../objects/message-component.json"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "./attachment-reference.json"
      }
    },
    "flags": {
      "type": "integer"
    }
  }
}
