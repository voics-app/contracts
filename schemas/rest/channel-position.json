{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/channel-position.json",
  "title": "ChannelPosition",
  "description": "One entry of PATCH /guilds/{id}/channels.",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "$ref": "../objects/snowflake.json"
    },
    "position": {
      "type": [
        "integer",
        "null"
      ]
    },
    "lock_permissions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "parent_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
