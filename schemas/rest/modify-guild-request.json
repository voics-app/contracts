{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/modify-guild-request.json",
  "title": "ModifyGuildRequest",
  "description": "PATCH /guilds/{id} body (partial). `voice_region` is a Discordy extra.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "banner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Image data URI (png, jpeg, gif or webp, at most 10 MiB) to set the banner; null removes it."
    },
    "splash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Image data URI (png, jpeg, gif or webp, at most 10 MiB) to set the invite splash; null removes it."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_id": {
      "$ref": "../objects/snowflake.json"
    },
    "afk_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "afk_timeout": {
      "type": "integer"
    },
    "system_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_channel_flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63,
      "description": "Bit set of system message suppressions: 1 join notifications, 2 server boosts, 4 setup tips, 8 join reply buttons, 16 role subscription purchases, 32 their reply buttons. A set bit turns that message off; 0 keeps all on. Join messages are posted to system_channel_id when it is set and bit 1 is clear."
    },
    "rules_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_updates_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "preferred_locale": {
      "type": "string"
    },
    "verification_level": {
      "type": "integer"
    },
    "default_message_notifications": {
      "type": "integer"
    },
    "explicit_content_filter": {
      "type": "integer"
    },
    "voice_region": {
      "type": "string"
    }
  }
}
