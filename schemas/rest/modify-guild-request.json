{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/modify-guild-request.json",
  "title": "ModifyGuildRequest",
  "description": "PATCH /guilds/{id} body (partial). `voice_region` is a Discordy extra.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "banner": {
      "type": [
        "string",
        "null"
      ]
    },
    "splash": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_id": {
      "$ref": "../objects/snowflake.json"
    },
    "afk_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "afk_timeout": {
      "type": "integer"
    },
    "system_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_channel_flags": {
      "type": "integer"
    },
    "rules_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_updates_channel_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "preferred_locale": {
      "type": "string"
    },
    "verification_level": {
      "type": "integer"
    },
    "default_message_notifications": {
      "type": "integer"
    },
    "explicit_content_filter": {
      "type": "integer"
    },
    "voice_region": {
      "type": "string"
    }
  }
}
