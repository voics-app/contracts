{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/update-guild-discovery-request.json",
  "title": "UpdateGuildDiscoveryRequest",
  "description": "PUT /guilds/{guild_id}/discovery body. `enabled: false` removes the listing; otherwise `category` is required.",
  "type": "object",
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 24
      },
      "maxItems": 5
    }
  }
}
