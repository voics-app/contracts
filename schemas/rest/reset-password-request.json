{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/reset-password-request.json",
  "title": "ResetPasswordRequest",
  "description": "POST /auth/reset-password body.",
  "type": "object",
  "required": [
    "token",
    "password"
  ],
  "properties": {
    "token": {
      "type": "string",
      "description": "Token from the reset email."
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}
