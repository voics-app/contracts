{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-guild-template-request.json",
  "title": "CreateGuildTemplateRequest",
  "description": "POST /guilds/{guild_id}/templates body. A guild has at most one template.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    }
  }
}
