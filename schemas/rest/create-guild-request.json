{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-guild-request.json",
  "title": "CreateGuildRequest",
  "description": "POST /guilds body.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "voice_region": {
      "type": "string"
    },
    "verification_level": {
      "type": "integer"
    },
    "default_message_notifications": {
      "type": "integer"
    },
    "explicit_content_filter": {
      "type": "integer"
    }
  }
}
