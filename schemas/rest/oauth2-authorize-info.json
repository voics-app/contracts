{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/oauth2-authorize-info.json",
  "title": "OAuth2AuthorizeInfo",
  "description": "Bot-install consent information. Only bot and applications.commands are supported.",
  "type": "object",
  "required": [
    "application",
    "user",
    "guilds",
    "permissions",
    "scopes"
  ],
  "properties": {
    "application": {
      "$ref": "../objects/application.json"
    },
    "bot": {
      "$ref": "../objects/user.json"
    },
    "user": {
      "$ref": "../objects/user.json"
    },
    "guilds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OAuth2Guild"
      }
    },
    "permissions": {
      "$ref": "../objects/permission-bitset.json",
      "description": "Permissions requested by the invite URL."
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bot",
          "applications.commands"
        ]
      }
    }
  },
  "$defs": {
    "OAuth2Guild": {
      "title": "OAuth2Guild",
      "description": "A guild the user can add the bot to.",
      "type": "object",
      "required": [
        "id",
        "name",
        "icon",
        "permissions",
        "bot_permissions",
        "installation_revision"
      ],
      "properties": {
        "id": {
          "$ref": "../objects/snowflake.json"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "$ref": "../objects/permission-bitset.json"
        },
        "installation_revision": {
          "$ref": "../objects/bot-installation-revision.json"
        },
        "bot_permissions": {
          "anyOf": [
            {
              "$ref": "../objects/permission-bitset.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null if the bot is absent; otherwise its current effective permissions. Reauthorization acknowledges these permissions without changing the shared installation."
        }
      }
    }
  }
}
