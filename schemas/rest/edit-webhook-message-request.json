{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/edit-webhook-message-request.json",
  "title": "EditWebhookMessageRequest",
  "description": "PATCH /webhooks/{app_id}/{token}/messages/@original body.",
  "type": "object",
  "properties": {
    "content": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "embeds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "../objects/embed.json"
      },
      "maxItems": 10
    },
    "allowed_mentions": {
      "anyOf": [
        {
          "$ref": "../objects/allowed-mentions.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "../objects/message-component.json"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "./attachment-reference.json"
      }
    }
  }
}
