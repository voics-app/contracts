{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/modify-soundboard-sound-request.json",
  "title": "ModifySoundboardSoundRequest",
  "description": "Update sound metadata.",
  "type": "object",
  "required": [],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
