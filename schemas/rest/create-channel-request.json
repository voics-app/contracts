{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/rest/create-channel-request.json",
  "title": "CreateChannelRequest",
  "description": "POST /guilds/{id}/channels body.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "type": {
      "type": "integer"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "bitrate": {
      "type": "integer"
    },
    "user_limit": {
      "type": "integer"
    },
    "rate_limit_per_user": {
      "type": "integer"
    },
    "position": {
      "type": "integer"
    },
    "permission_overwrites": {
      "type": "array",
      "items": {
        "$ref": "../objects/permission-overwrite.json"
      }
    },
    "parent_id": {
      "anyOf": [
        {
          "$ref": "../objects/snowflake.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "nsfw": {
      "type": "boolean"
    },
    "rtc_region": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_auto_archive_duration": {
      "type": "integer"
    },
    "delivery_mode": {
      "$ref": "../objects/delivery-mode.json"
    },
    "voice_region": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
