{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/gateway/dispatch/ready.json",
  "title": "ReadyEvent",
  "description": "READY: the internal ready state plus session details.",
  "allOf": [
    {
      "$ref": "../../internal/user-ready.json"
    },
    {
      "type": "object",
      "required": [
        "v",
        "session_id",
        "resume_gateway_url"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "description": "Gateway version (1)."
        },
        "session_id": {
          "type": "string"
        },
        "resume_gateway_url": {
          "type": "string"
        },
        "application": {
          "$ref": "#/$defs/ReadyApplication"
        },
        "read_state": {
          "type": "array",
          "items": { "$ref": "../../objects/read-state.json" }
        },
        "read_state_versioned": {
          "const": true,
          "description": "Present only after successful certified messages hydration. Standard counts use authoritative snapshots rather than CREATE increments; private decrypted traffic stays local. Absent means legacy behavior."
        }
      },
      "if": { "required": ["read_state_versioned"], "properties": { "read_state_versioned": { "const": true } } },
      "then": {
        "required": ["read_state"],
        "properties": {
          "read_state": {
            "type": "array",
            "items": { "type": "object", "required": ["read_state_version"], "properties": { "read_state_version": { "$ref": "../../objects/read-state-version.json" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "ReadyApplication": {
      "title": "ReadyApplication",
      "description": "The bot's application.",
      "type": "object",
      "required": [
        "id",
        "flags"
      ],
      "properties": {
        "id": {
          "$ref": "../../objects/snowflake.json"
        },
        "flags": {
          "type": "integer"
        }
      }
    }
  }
}
