{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/gateway/dispatch/message-poll-vote-remove.json",
  "title": "MessagePollVoteRemoveEvent",
  "type": "object",
  "required": [
    "user_id",
    "channel_id",
    "message_id",
    "answer_id",
    "answer_ids",
    "vote_version",
    "results"
  ],
  "properties": {
    "user_id": {
      "$ref": "../../objects/snowflake.json"
    },
    "channel_id": {
      "$ref": "../../objects/snowflake.json"
    },
    "message_id": {
      "$ref": "../../objects/snowflake.json"
    },
    "guild_id": {
      "$ref": "../../objects/snowflake.json"
    },
    "answer_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "answer_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "description": "Complete post-mutation selection of user_id, including empty after the last removal."
    },
    "vote_version": {
      "$ref": "../../objects/poll-version.json"
    },
    "results": {
      "$ref": "../../objects/poll-results.json"
    }
  },
  "additionalProperties": false,
  "description": "Complete authoritative post-mutation counts and actor selection. Single-choice replacement can emit REMOVE and ADD with identical versions/results. Apply snapshots, never deltas."
}
