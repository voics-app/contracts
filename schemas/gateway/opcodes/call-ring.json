{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/gateway/opcodes/call-ring.json",
  "title": "CallRingPayload",
  "description": "Op 26 CALL_RING. Rings the listed members of a DM channel for a call the sender is in.",
  "type": "object",
  "required": [
    "channel_id",
    "user_ids"
  ],
  "properties": {
    "channel_id": {
      "$ref": "../../objects/snowflake.json"
    },
    "user_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Users to ring, 1 to 10.",
      "items": {
        "$ref": "../../objects/snowflake.json"
      }
    }
  }
}
