{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discordy.voics.nl/contracts/schemas/gateway/frame.json",
  "title": "GatewayFrame",
  "description": "Every gateway frame (both directions). `s` and `t` are only set on DISPATCH (op 0).",
  "type": "object",
  "required": [
    "op",
    "d"
  ],
  "properties": {
    "op": {
      "type": "integer",
      "description": "Gateway opcode (protocol.json gateway.opcodes)."
    },
    "d": {
      "description": "Opcode payload."
    },
    "s": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Sequence number of a dispatch."
    },
    "t": {
      "type": [
        "string",
        "null"
      ],
      "description": "Dispatch event name."
    }
  }
}
