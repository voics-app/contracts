{
  "name": "@voics-app/contracts-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Discordy contracts: OpenAPI, JSON Schemas, constants and generated packages.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "pnpm --filter @voics-app/contracts-codegen run validate",
    "codegen": "pnpm --filter @voics-app/contracts-codegen run codegen",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter @voics-app/contracts run build"
  }
}
