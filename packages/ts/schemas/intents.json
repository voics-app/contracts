{
  "$schema": "./schemas/registry/intents.schema.json",
  "source": "https://discord.com/developers/docs/events/gateway#list-of-intents",
  "serialization": "Intents are sent in IDENTIFY as an integer bitfield. User sessions implicitly receive every intent.",
